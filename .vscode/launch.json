{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Argo",
            "type": "debugpy",
            "request": "launch",
            "args": [
                "runserver",
                "127.0.0.1:8000",
                "--noreload",
                "--settings=argo_project.settings"
            ],
            "env": {
                "DJANGO_SETTINGS_MODULE": "argo_project.settings"
            },
            "django": false,
            "justMyCode": true,
            "autoStartBrowser": false,
            "program": "${workspaceFolder}/manage.py"
        },
        {
            "name": "Argo Search test search",
            "type": "debugpy",
            "request": "launch",
            "args": [
                "test",
                "argo.tests.test_ib.SearchTest.test_search_create",
                "--keepdb",
                "--settings=argo_project.settings"
            ],
            "env": {
                "DJANGO_SETTINGS_MODULE": "argo_project.settings"
            },
            "django": true,
            "autoStartBrowser": false,
            "program": "${workspaceFolder}/manage.py"
        },
        {
            "name": "IB test_load_data",
            "type": "debugpy",
            "request": "launch",
            "args": [
                "test",
                "argo.tests.test_ib.HistoricTest.test_load_data",
                "--keepdb",
                "--settings=argo_project.settings"
            ],
            "env": {
                "DJANGO_SETTINGS_MODULE": "argo_project.settings"
            },
            "django": true,
            "autoStartBrowser": false,
            "program": "${workspaceFolder}/manage.py"
        },
        {
            "name": "IB backtest",
            "type": "debugpy",
            "request": "launch",
            "args": [
                "test",
                "argo.tests.test_backtest.TestBacktest.test_run_breakout",
                "--keepdb",
                "--settings=argo_project.settings"
            ],
            "env": {
                "DJANGO_SETTINGS_MODULE": "argo_project.settings"
            },
            "django": true,
            "autoStartBrowser": false,
            "program": "${workspaceFolder}/manage.py"
        },
        {
            "name": "Argo: Celery",
            "type": "debugpy",
            "request": "launch",
            "module": "celery",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": [
                "-A",
                "argo_project.celery_app",
                "worker",
                "-l",
                "info",
                "-P",
                "solo",
                "-E",
                "-n",
                "argo@%h",
                "-Q",
                "argo"
            ],
            "env": {
                "DJANGO_SETTINGS_MODULE": "argo_project.settings"
            }
        },
        {
            "name": "Argo: Celery Beat",
            "type": "debugpy",
            "request": "launch",
            "module": "celery",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": [
                "-A",
                "argo_project.celery_app",
                "beat",
                "-l",
                "info",
                "-S",
                "django",
                "-s",
                "celerybeat-argo-schedule",
                "--pidfile=celerybeat-argo.pid"
            ],
            "env": {
                "DJANGO_SETTINGS_MODULE": "argo_project.settings"
            }
        },
        {
            "name": "Argo MakeMigration",
            "type": "debugpy",
            "request": "launch",
            "args": [
                "makemigrations",
                "argo",
                "--settings=argo_project.settings"
            ],
            "env": {
                "DJANGO_SETTINGS_MODULE": "argo_project.settings"
            },
            "django": true,
            "autoStartBrowser": false,
            "program": "${workspaceFolder}/manage.py"
        },
        {
            "name": "Argo Migrate",
            "type": "debugpy",
            "request": "launch",
            "args": [
                "migrate",
                "--settings=argo_project.settings"
            ],
            "env": {
                "DJANGO_SETTINGS_MODULE": "argo_project.settings"
            },
            "django": true,
            "autoStartBrowser": false,
            "program": "${workspaceFolder}/manage.py"
        },
        {
            "name": "Argo CreateSuperuser",
            "type": "debugpy",
            "request": "launch",
            "console": "integratedTerminal",
            "args": [
                "createsuperuser",
                "--settings=argo_project.settings"
            ],
            "env": {
                "DJANGO_SETTINGS_MODULE": "argo_project.settings"
            },
            "django": true,
            "program": "${workspaceFolder}/manage.py"
        },
        {
            "name": "Nautilus",
            "type": "debugpy",
            "request": "launch",
            "autoStartBrowser": false,
            "program": "${workspaceFolder}/run_nautilus.py"
        },
        {
            "name": "Guillermo",
            "type": "debugpy",
            "request": "launch",
            "args": [
                "runserver",
                "localhost:8080",
                "--noreload",
                "--skip-checks"
            ],
            "django": false,
            "justMyCode": true,
            "autoStartBrowser": false,
            "program": "${workspaceFolder}/manage.py"
        },
        {
            "name": "Guillermo: Celery",
            "type": "debugpy",
            "request": "launch",
            "module": "celery",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": [
                "-A",
                "project.celery_app",
                "worker",
                "-l",
                "info",
                "-P",
                "solo",
                "-E",
                "-n",
                "guillermo@%h",
                "-Q",
                "guillermo,queue.normal,queue.heavy"
            ],
            "env": {
                "DJANGO_SETTINGS_MODULE": "project.settings"
            }
        },
        {
            "name": "Guillermo: Celery Beat",
            "type": "debugpy",
            "request": "launch",
            "module": "celery",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": [
                "-A",
                "project.celery_app",
                "beat",
                "-l",
                "info",
                "-S",
                "django",
                "-s",
                "celerybeat-guillermo-schedule",
                "--pidfile=celerybeat-guillermo.pid"
            ],
            "env": {
                "DJANGO_SETTINGS_MODULE": "project.settings"
            }
        },
        {
            "name": "Guillermo MakeMigration",
            "type": "debugpy",
            "request": "launch",
            "args": [
                "makemigrations",
            ],
            "django": true,
            "autoStartBrowser": false,
            "program": "${workspaceFolder}/manage.py"
        },
          {
            "name": "Guillermo Migrate",
            "type": "debugpy",
            "request": "launch",
            "args": [
                "migrate"
            ],
            "django": true,
            "autoStartBrowser": false,
            "program": "${workspaceFolder}/manage.py"
        },
        {
            "name": "Guillermo CreateSuperuser",
            "type": "debugpy",
            "request": "launch",
            "console": "integratedTerminal",
            "args": [
                "createsuperuser"
            ],
            "django": true,
            "program": "${workspaceFolder}/manage.py"
        },

        
    ]
}